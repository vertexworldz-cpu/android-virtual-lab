# Copy to .env (never commit it). All settings are optional for local use.

# development | production (production hides API docs)
ORIGIN_ENV=development

# Default is SQLite at data/origin.db. For PostgreSQL (see docker-compose.yml):
# ORIGIN_DATABASE_URL=postgresql+psycopg://origin:CHANGE_ME@127.0.0.1:5432/origin

# Where the database, uploads and model checkpoints live.
# ORIGIN_DATA_DIR=./data

# Origins allowed to make state-changing requests (JSON list).
# ORIGIN_ALLOWED_ORIGINS=["http://localhost:3000"]

# Set true when served over HTTPS so the session cookie is Secure.
ORIGIN_COOKIE_SECURE=false

# After the owner account exists, set false to stop new sign-ups.
ORIGIN_ALLOW_REGISTRATION=true

# auto | cpu | cuda | mps
ORIGIN_INFERENCE_DEVICE=auto

# Used by docker-compose.yml only.
POSTGRES_PASSWORD=CHANGE_ME
